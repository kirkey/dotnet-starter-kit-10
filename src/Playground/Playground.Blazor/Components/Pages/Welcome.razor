@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Welcome to FSH Framework</PageTitle>

<AuthorizeView>
    <Authorized>
        <!-- Authenticated View with Standard App Layout -->
        <FshPageHeader Title="Welcome to FSH Framework"
                       Description="Enterprise-Grade .NET Starter Kit for Modern Applications" />
        
        <div class="welcome-authenticated">
            <!-- Quick Actions -->
            <MudPaper Class="fsh-card pa-6 mb-4">
                <MudText Typo="Typo.h5" Class="mb-4 fw-700">Quick Actions</MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6" md="3">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Dashboard"
                                   Href="/dashboard"
                                   Size="Size.Large">
                            Dashboard
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Secondary" 
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                   Href="/todos"
                                   Size="Size.Large">
                            Todo Lists
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Info" 
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.People"
                                   Href="/users"
                                   Size="Size.Large">
                            Users
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Tertiary" 
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.History"
                                   Href="/audits"
                                   Size="Size.Large">
                            Audit Logs
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Key Features -->
            <MudPaper Class="fsh-card pa-6 mb-4">
                <MudText Typo="Typo.h5" Class="mb-4 fw-700">Key Features</MudText>
                <MudGrid Spacing="4">
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="feature-card-simple">
                            <MudCardContent>
                                <MudStack Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Primary" Size="Size.Large" />
                                    <MudText Typo="Typo.h6" Class="fw-700">High Performance</MudText>
                                    <MudText Typo="Typo.body2">Built on .NET 10 with optimized runtime and async operations</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="feature-card-simple">
                            <MudCardContent>
                                <MudStack Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Secondary" Size="Size.Large" />
                                    <MudText Typo="Typo.h6" Class="fw-700">Enterprise Security</MudText>
                                    <MudText Typo="Typo.body2">JWT authentication with role-based access control</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="feature-card-simple">
                            <MudCardContent>
                                <MudStack Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Architecture" Color="Color.Info" Size="Size.Large" />
                                    <MudText Typo="Typo.h6" Class="fw-700">Clean Architecture</MudText>
                                    <MudText Typo="Typo.body2">Modular design with domain-driven development</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="feature-card-simple">
                            <MudCardContent>
                                <MudStack Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.CorporateFare" Color="Color.Success" Size="Size.Large" />
                                    <MudText Typo="Typo.h6" Class="fw-700">Multi-Tenancy</MudText>
                                    <MudText Typo="Typo.body2">Database-per-tenant isolation for SaaS applications</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="feature-card-simple">
                            <MudCardContent>
                                <MudStack Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Warning" Size="Size.Large" />
                                    <MudText Typo="Typo.h6" Class="fw-700">Audit Logging</MudText>
                                    <MudText Typo="Typo.body2">Comprehensive audit trails for compliance</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="feature-card-simple">
                            <MudCardContent>
                                <MudStack Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Tertiary" Size="Size.Large" />
                                    <MudText Typo="Typo.h6" Class="fw-700">Developer Friendly</MudText>
                                    <MudText Typo="Typo.body2">OpenAPI docs, Swagger UI, and code generation</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Available Modules -->
            <MudPaper Class="fsh-card pa-6">
                <MudText Typo="Typo.h5" Class="mb-4 fw-700">Available Modules</MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Class="pa-4" Elevation="2">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudAvatar Color="Color.Primary" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.People" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="fw-700">Identity</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">User management</MudText>
                                </div>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Class="pa-4" Elevation="2">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudAvatar Color="Color.Secondary" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="fw-700">Multitenancy</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Tenant management</MudText>
                                </div>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Class="pa-4" Elevation="2">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudAvatar Color="Color.Info" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="fw-700">Todo</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Task management</MudText>
                                </div>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Class="pa-4" Elevation="2">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudAvatar Color="Color.Warning" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.History" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="fw-700">Auditing</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Activity tracking</MudText>
                                </div>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Class="pa-4" Elevation="2">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudAvatar Color="Color.Success" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="fw-700">Catalog</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Product catalog</MudText>
                                </div>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Class="pa-4" Elevation="2">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudAvatar Color="Color.Tertiary" Size="Size.Medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Extension" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle1" Class="fw-700">Custom</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Add your own</MudText>
                                </div>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Unauthenticated View - Landing Page Style -->
        <div class="welcome-landing">
            <MudContainer MaxWidth="MaxWidth.Large">
                <!-- Hero Section -->
                <div class="hero-section">
                    <div class="hero-content">
                        <MudChip T="string" Icon="@Icons.Material.Filled.Bolt" Color="Color.Primary" Size="Size.Small" Class="mb-4">
                            .NET 10 | Blazor | Multi-Tenant
                        </MudChip>
                        <MudText Typo="Typo.h2" Class="hero-title mb-4" Align="Align.Center">
                            <strong>Full Stack Hero</strong> Framework
                        </MudText>
                        <MudText Typo="Typo.h5" Class="hero-subtitle mb-4" Align="Align.Center">
                            Enterprise-Grade .NET Starter Kit
                        </MudText>
                        <MudText Typo="Typo.body1" Class="hero-description mb-6" Align="Align.Center">
                            Build scalable, multi-tenant SaaS applications with clean architecture, 
                            modular design, and production-ready features out of the box.
                        </MudText>
                        <MudStack Row="true" Justify="Justify.Center" Spacing="3" Class="mb-8">
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.Login"
                                       OnClick="NavigateToLogin">
                                Get Started
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary" 
                                       Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.Code"
                                       Href="https://github.com/fullstackhero"
                                       Target="_blank">
                                View on GitHub
                            </MudButton>
                        </MudStack>
                    </div>
                </div>

                <!-- Features Grid -->
                <MudGrid Spacing="4" Class="mt-8">
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="fsh-card pa-4 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.h6" Class="fw-700 mb-2">Fast</MudText>
                            <MudText Typo="Typo.body2">Built on .NET 10 with performance optimizations</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="fsh-card pa-4 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Secondary" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.h6" Class="fw-700 mb-2">Secure</MudText>
                            <MudText Typo="Typo.body2">JWT authentication and role-based access control</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="fsh-card pa-4 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Architecture" Color="Color.Info" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.h6" Class="fw-700 mb-2">Modular</MudText>
                            <MudText Typo="Typo.body2">Clean architecture with independent modules</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="fsh-card pa-4 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.CorporateFare" Color="Color.Success" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.h6" Class="fw-700 mb-2">Multi-Tenant</MudText>
                            <MudText Typo="Typo.body2">Database isolation for SaaS applications</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <!-- Technology Stack -->
                <MudPaper Class="fsh-card pa-6 mt-6">
                    <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4 fw-700">Built With Modern Technology</MudText>
                    <MudGrid Spacing="3">
                        <MudItem xs="6" sm="4" md="3" Class="text-center">
                            <MudText Typo="Typo.h6">.NET 10</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Runtime</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" Class="text-center">
                            <MudText Typo="Typo.h6">Blazor</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">UI Framework</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" Class="text-center">
                            <MudText Typo="Typo.h6">EF Core 10</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">ORM</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" Class="text-center">
                            <MudText Typo="Typo.h6">PostgreSQL</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Database</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" Class="text-center">
                            <MudText Typo="Typo.h6">Redis</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Caching</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" Class="text-center">
                            <MudText Typo="Typo.h6">Hangfire</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Background Jobs</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" Class="text-center">
                            <MudText Typo="Typo.h6">MudBlazor</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Components</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" Class="text-center">
                            <MudText Typo="Typo.h6">Serilog</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Logging</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudContainer>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task NavigateToLogin()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User?.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}

