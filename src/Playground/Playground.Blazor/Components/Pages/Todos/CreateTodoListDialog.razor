@using FSH.Playground.Blazor.Api
@inject ISnackbar Snackbar
@inject ITodosClient TodoClient

<MudDialog>
    <TitleContent>
        <MudStack Spacing="0">
            <MudText Typo="Typo.h6" Class="fw-600">@(IsEditMode ? "Edit Todo List" : "Create New Todo List")</MudText>
            <MudText Typo="Typo.caption" Class="text-muted">
                @(IsEditMode ? "Modify list details" : "Organize your tasks with a new list")
            </MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudStack Spacing="3" Class="mt-2">
                <MudTextField @bind-Value="_model.Name"
                              Label="List Name"
                              Placeholder="e.g., Project Alpha, Shopping, Weekly Tasks"
                              Required="true"
                              RequiredError="List name is required"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.List"
                              Immediate="true" />

                <MudTextField @bind-Value="_model.Description"
                              Label="Description"
                              Placeholder="Brief description of this todo"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Description"
                              Lines="2" />

                <MudSelect @bind-Value="_model.Priority"
                           Label="Priority"
                           Variant="Variant.Outlined"
                           Adornment="Adornment.Start"
                           AdornmentIcon="@Icons.Material.Filled.PriorityHigh">
                    <MudSelectItem Value="1">Low</MudSelectItem>
                    <MudSelectItem Value="2">Medium</MudSelectItem>
                    <MudSelectItem Value="3">High</MudSelectItem>
                </MudSelect>

                <MudDatePicker @bind-Date="_model.DueDate"
                               Label="Due Date"
                               Variant="Variant.Outlined"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                               Clearable="true"
                               Editable="true" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>@(IsEditMode ? "Saving..." : "Creating...")</span>
            }
            else
            {
                <span>@(IsEditMode ? "Save Changes" : "Create List")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
    
    [Parameter] public object? ExistingList { get; set; }

    private MudForm? _form;
    private bool _busy;
    private TodoListModel _model = new();

    private bool IsEditMode => ExistingList != null;

    protected override void OnInitialized()
    {
        if (ExistingList != null)
        {
            var list = ExistingList as TodoSummaryDto;
            if (list != null)
            {
                _model = new TodoListModel
                {
                    Name = list.Name ?? string.Empty,
                    Description = list.Description,
                    Priority = list.Priority,
                    DueDate = list.DueDate?.DateTime
                };
            }
        }
        else
        {
            _model.Priority = 2; // Default to Medium
        }
    }

    private async Task Submit()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _busy = true;
        try
        {
            if (IsEditMode)
            {
                var list = ExistingList as TodoSummaryDto;
                if (list != null)
                {
                    var command = new UpdateTodoCommand
                    {
                        Name = _model.Name,
                        Description = _model.Description,
                        Priority = _model.Priority,
                        DueDate = _model.DueDate.HasValue ? new DateTimeOffset(_model.DueDate.Value) : null
                    };
                    await TodoClient.TodoPutAsync(list.Id, command);
                }
            }
            else
            {
                var command = new CreateTodoCommand
                {
                    Name = _model.Name,
                    Description = _model.Description,
                    Priority = _model.Priority,
                    DueDate = _model.DueDate.HasValue ? new DateTimeOffset(_model.DueDate.Value) : null
                };
                await TodoClient.TodoPostAsync(command);
            }
            
            Snackbar.Add(IsEditMode ? "Todo updated successfully" : "Todo created successfully", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to {(IsEditMode ? "update" : "create")} todo: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private class TodoListModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public int Priority { get; set; } = 2;
        public DateTime? DueDate { get; set; }
    }
}
