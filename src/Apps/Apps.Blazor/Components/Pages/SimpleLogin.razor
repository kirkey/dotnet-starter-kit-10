@page "/login"
@layout EmptyLayout
@using FSH.Framework.Shared.Multitenancy
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Login - FSH Framework</PageTitle>

<div class="login-container">
    <MudContainer MaxWidth="MaxWidth.Small" Class="login-content">
        <MudPaper Elevation="4" Class="pa-8" Style="border-radius: 16px;">
            <!-- Brand Logo -->
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
                <MudAvatar Color="Color.Primary" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" />
                </MudAvatar>
                <MudText Typo="Typo.h6" Class="fw-700">Full Stack Hero</MudText>
            </MudStack>

            <!-- Header -->
            <MudStack Spacing="1" Class="mb-6" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4" Class="fw-700">Welcome back</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Sign in to your account to continue</MudText>
            </MudStack>

            <!-- Social Login Buttons (Disabled) -->
            <MudStack Spacing="2" Class="mb-4">
                <MudButton Variant="Variant.Outlined" 
                           FullWidth="true" 
                           Disabled="true"
                           StartIcon="@Icons.Custom.Brands.Apple"
                           Color="Color.Default">
                    Continue with Apple
                </MudButton>
                <MudButton Variant="Variant.Outlined" 
                           FullWidth="true" 
                           Disabled="true"
                           Color="Color.Default">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <svg width="18" height="18" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        <span>Continue with Google</span>
                    </MudStack>
                </MudButton>
            </MudStack>

            <!-- Divider -->
            <MudDivider Class="my-6">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Or continue with</MudText>
            </MudDivider>

            <!-- Login Form -->
            <form method="post" action="/bff/auth/login">
                <MudStack Spacing="3">
                    <!-- Tenant Field -->
                    <MudTextField T="string" 
                                  Label="Tenant" 
                                  Variant="Variant.Outlined"
                                  @bind-Value="_tenant"
                                  name="Tenant"
                                  Required="true"
                                  HelperText="Enter your tenant identifier" />

                    <!-- Email Field -->
                    <MudTextField T="string" 
                                  Label="Email" 
                                  Variant="Variant.Outlined"
                                  @bind-Value="_email"
                                  name="Email"
                                  InputType="InputType.Email"
                                  Required="true"
                                  Placeholder="admin@root.com" />

                    <!-- Password Field -->
                    <MudTextField T="string" 
                                  Label="Password" 
                                  Variant="Variant.Outlined"
                                  @bind-Value="_password"
                                  name="Password"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Required="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  OnAdornmentClick="TogglePassword" />

                    <!-- Forgot Password Link -->
                    <MudStack Row="true" Justify="Justify.FlexEnd">
                        <MudLink Href="#" Typo="Typo.body2">Forgot your password?</MudLink>
                    </MudStack>

                    <!-- Login Button -->
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="mt-2">
                        Sign In
                    </MudButton>

                    <!-- Sign Up Link -->
                    <MudStack Row="true" Justify="Justify.Center" Class="mt-2">
                        <MudText Typo="Typo.body2">
                            Don't have an account?
                        </MudText>
                        <MudLink Href="#" Typo="Typo.body2" Class="fw-700">Sign up</MudLink>
                    </MudStack>
                </MudStack>
            </form>
        </MudPaper>

        <!-- Footer -->
        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mt-6">
            By signing in, you agree to our 
            <MudLink Href="#" Typo="Typo.body2">Terms of Service</MudLink> and 
            <MudLink Href="#" Typo="Typo.body2">Privacy Policy</MudLink>
        </MudText>
    </MudContainer>
</div>

@code {
    private string _tenant = "root";
    private string _email = MultitenancyConstants.Root.EmailAddress;
    private string _password = MultitenancyConstants.DefaultPassword;
    private bool _showPassword = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private void TogglePassword()
    {
        _showPassword = !_showPassword;
    }
}
